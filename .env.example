# Issuer
ISSUER_HTTP_PORT=8080
DEFAULT_TENANT_ID=default-tenant
ISSUER_LOG_LEVEL=info

# Verifier
VERIFIER_HTTP_PORT=8081
VERIFIER_LOG_LEVEL=info
VERIFIER_DB_DSN=postgres://credentialsvc:credentialsvc@postgres:5432/credentialsvc?sslmode=disable
VERIFIER_USE_DB_TRUST_REGISTRY=true
DEFAULT_TENANT_ID=default-tenant

# Postgres
POSTGRES_USER=credentialsvc
POSTGRES_PASSWORD=credentialsvc
POSTGRES_DB=credentialsvc

# Samples - Service-to-Service Demo
API_HTTP_PORT=8082
ISSUER_BASE_URL=http://issuer:8080
GATEWAY_AUTHORIZE_URL=http://verifier:8081/v1/gateway/authorize
API_BASE_URL=http://s2s-api:8082
