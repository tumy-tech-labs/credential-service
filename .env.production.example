# Example production configuration for credential service with Prometheus metrics

# =============================================================================
# Metrics Configuration
# =============================================================================

# Enable Prometheus metrics collection
METRICS_TYPE=prometheus

# Custom metrics namespace (default: credential_service)
METRICS_NAMESPACE=demo_credential_service

# =============================================================================
# Redis Configuration (for rate limiting and caching)  
# =============================================================================

# Redis connection for rate limiting and caching
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# Enable gateway response caching
GATEWAY_CACHE=true

# Enable rate limiting with Redis backend
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_WINDOW=1000
RATE_LIMIT_WINDOW_SECONDS=60

# =============================================================================
# Service Configuration
# =============================================================================

# HTTP port for the service
HTTP_PORT=8080

# Database connection
DB_DSN=postgres://user:password@postgres:5432/credential_service?sslmode=disable

# Use database-backed trust registry instead of in-memory
USE_DB_TRUST_REGISTRY=true

# Default tenant for single-tenant mode
DEFAULT_TENANT_ID=demo-tenant

# Tenancy mode: single or multi
TENANCY_MODE=single

# Logging level
LOG_LEVEL=info

# =============================================================================
# Security Configuration  
# =============================================================================

# JWT issuer identifier
JWT_ISSUER=did:web:demo.example.com

# Maximum delegation depth allowed
MAX_DELEGATION_DEPTH=3

# Credential TTL limits (seconds)
MAX_CREDENTIAL_TTL=86400  # 24 hours
DEFAULT_CREDENTIAL_TTL=3600  # 1 hour